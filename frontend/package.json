{
  "name": "sunfleck-frontend",
  "private": true,
  "version": "1.0.3",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
    "lint": "eslint .",
    "check:unused": "knip && node scripts/check-translation-keys.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "screenshots": "playwright test -c e2e/screenshots.config.ts",
    "api-types": "openapi-typescript src/api/openapi.json --output src/api/schema.d.ts"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@mantine/core": "^9.8.0",
    "@mantine/form": "^9.8.0",
    "@mantine/hooks": "^9.8.0",
    "@mantine/notifications": "^9.8.0",
    "@tabler/icons-react": "^3.51.0",
    "@tanstack/react-query": "^5.107.1",
    "i18next": "^27.1.1",
    "leaflet": "^1.9.4",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-easy-crop": "^6.2.5",
    "react-i18next": "^18.0.1",
    "react-leaflet": "^5.0.0",
    "react-router": "^8.5.1",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "^4.14.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "knip": "^6.45.1",
    "msw": "^3.0.5",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.33",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "workbox-window": "^7.4.1"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "^11.0.8",
    "workbox-build": {
      "glob": "^14.0.6"
    }
  }
}
