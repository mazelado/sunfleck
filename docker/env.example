# Required: a long random string. Generate one with:  openssl rand -base64 48
SECRET_KEY=

# The hostname(s) you use to reach Sunfleck, comma-separated (localhost is always allowed).
ALLOWED_HOSTS=plants.example.com
# The full URL(s) of those hostnames, needed for signing in and submitting forms.
CSRF_TRUSTED_ORIGINS=https://plants.example.com

# Recommended: the key that encrypts stored secrets, such as notification addresses. Generate
# one with:  docker compose run --rm sunfleck manage encryption_key
# Without it, a key is derived from SECRET_KEY, and changing SECRET_KEY loses those secrets.
# Setting it later is safe: what's stored stays readable while SECRET_KEY is unchanged.
# To replace a key, put the new one first and keep the old one after a comma, then run
#   docker compose run --rm sunfleck manage reencrypt_secrets
# after which the old one can be removed.
SUNFLECK_ENCRYPTION_KEY=

# The address you open Sunfleck at; notifications link to it.
SUNFLECK_PUBLIC_URL=https://plants.example.com

# Your time zone, e.g. Europe/Berlin or America/Chicago.
TIME_ZONE=UTC

# Set to true when Sunfleck runs behind a reverse proxy that provides HTTPS (Caddy, Traefik,
# Nginx Proxy Manager, ...), so that links in emails and invitations use https://.
SUNFLECK_BEHIND_PROXY=false

# Who can reach port 8000: only this computer (the default, for a reverse proxy on it), or
# 0.0.0.0 to open it to every network the computer is on, e.g. for phones at home without a proxy.
# SUNFLECK_LISTEN_ADDRESS=0.0.0.0

# Optional: an email server for password resets and invitations. Without it, emails aren't
# sent (the log only notes that one wasn't), and Admins copy invitation and password-reset
# links from the app instead. Special characters in the user name or password must be URL-encoded.
# EMAIL_URL=smtp+tls://user:password@mail.example.com:587
# EMAIL_FROM=Sunfleck <plants@example.com>

# Optional: use PostgreSQL instead of the built-in SQLite database.
# DATABASE_URL=postgres://sunfleck:password@postgres:5432/sunfleck

# Optional: use Redis for the background job queue instead of a file in the data volume.
# HUEY_REDIS_URL=redis://redis:6379/0

# Optional: stay on a version instead of the latest release: 1 for every compatible 1.x release,
# 1.0 for 1.0's bug fixes only, or 1.0.0. Read by Compose when it starts the containers.
# SUNFLECK_VERSION=1
