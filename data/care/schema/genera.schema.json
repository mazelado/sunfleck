{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mazelado/sunfleck/data/care/schema/genera.schema.json",
  "title": "Genera and species",
  "description": "Genera and common species, each linked to a care profile. See ../README.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["genera"],
  "properties": {
    "genera": { "type": "array", "items": { "$ref": "#/$defs/genus" }, "minItems": 1 }
  },
  "$defs": {
    "genus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["genus", "family", "archetype"],
      "properties": {
        "genus": { "$ref": "#/$defs/genusName" },
        "family": { "type": "string", "pattern": "^[A-Z][a-z]+aceae$" },
        "archetype": { "$ref": "#/$defs/archetypeKey" },
        "common_names": { "$ref": "#/$defs/commonNames" },
        "synonyms": { "type": "array", "items": { "$ref": "#/$defs/genusName" }, "uniqueItems": true },
        "note": { "$ref": "#/$defs/translated" },
        "toxicity": { "$ref": "#/$defs/toxicity" },
        "crop": { "$ref": "#/$defs/crop" },
        "species": { "type": "array", "items": { "$ref": "#/$defs/species" } }
      }
    },
    "species": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "$ref": "#/$defs/speciesName" },
        "common_names": { "$ref": "#/$defs/commonNames" },
        "synonyms": { "type": "array", "items": { "$ref": "#/$defs/speciesName" }, "uniqueItems": true },
        "archetype": { "$ref": "#/$defs/archetypeKey" },
        "note": { "$ref": "#/$defs/translated" },
        "toxicity": { "$ref": "#/$defs/toxicity" },
        "crop": { "$ref": "#/$defs/crop" }
      }
    },
    "crop": {
      "description": "When to sow, plant out and harvest, in weeks from the site's typical frost dates, for the sowing calendar. A species without its own takes its genus's.",
      "type": "object",
      "additionalProperties": false,
      "required": ["steps"],
      "properties": {
        "steps": {
          "description": "In order: what to do, and in which weeks from a frost date (negative is before it).",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["action", "after", "weeks"],
            "properties": {
              "action": { "enum": ["sow_indoors", "sow_outdoors", "plant_out"] },
              "after": { "enum": ["last_frost", "first_frost"] },
              "weeks": {
                "description": "The first and last week, from the frost date.",
                "type": "array",
                "items": { "type": "integer", "minimum": -26, "maximum": 26 },
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        },
        "harvest_days": {
          "description": "Days from the last step to the first harvest: fewest and most. Absent for flowers.",
          "type": "array",
          "items": { "type": "integer", "minimum": 1, "maximum": 400 },
          "minItems": 2,
          "maxItems": 2
        },
        "note": { "$ref": "#/$defs/translated" }
      }
    },
    "toxicity": {
      "description": "Known toxicity to pets, only as a source states it. Absent means unknown, never safe.",
      "type": "object",
      "additionalProperties": false,
      "required": ["sources"],
      "anyOf": [{ "required": ["cats"] }, { "required": ["dogs"] }],
      "properties": {
        "cats": { "const": "toxic" },
        "dogs": { "const": "toxic" },
        "sources": {
          "description": "The page of each source that names this plant as toxic, e.g. its ASPCA entry.",
          "type": "array",
          "items": { "type": "string", "pattern": "^https://" },
          "minItems": 1,
          "uniqueItems": true
        },
        "note": { "$ref": "#/$defs/translated" }
      }
    },
    "genusName": { "type": "string", "pattern": "^[A-Z][a-z]+$" },
    "speciesName": {
      "description": "Genus and species epithet; hybrids are written with ×, e.g. Mentha × piperita.",
      "type": "string",
      "pattern": "^[A-Z][a-z]+ (× )?[a-z][a-z-]+$"
    },
    "archetypeKey": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "commonNames": {
      "description": "Common names per language code, most common first.",
      "type": "object",
      "propertyNames": { "pattern": "^[a-z]{2}(-[A-Z]{2})?$" },
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string", "minLength": 1, "maxLength": 100 },
        "minItems": 1,
        "uniqueItems": true
      }
    },
    "translated": {
      "type": "object",
      "required": ["en"],
      "propertyNames": { "pattern": "^[a-z]{2}(-[A-Z]{2})?$" },
      "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 300 }
    }
  }
}
